# The last configuration file for the Nginx reverse proxy.
# This file is used to configure the reverse proxy for Grafana and JupyterHub.
# JUVRE is served at /lab/juvre/ alongside the existing services.

# Redirect HTTP → HTTPS
server {
    listen 80;
    server_name mc-a4.lab.uvalight.net;
    return 301 https://$host$request_uri;
}

# HTTPS vhost
server {
    listen 443 ssl http2;
    server_name mc-a4.lab.uvalight.net;

    ssl_certificate     /etc/letsencrypt/live/mc-a4.lab.uvalight.net/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mc-a4.lab.uvalight.net/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    # JUVRE entry point. Exact match leaves other services' paths intact.
    location = / {
        return 302 /lab/juvre/;
    }

    location = /lab/juvre {
        return 302 /lab/juvre/;
    }

    location ^~ /lab/juvre/ {
        # Preserve the prefix configured with hub.baseUrl in Helm.
        proxy_pass http://192.168.49.2:80;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
        proxy_buffering off;
        client_max_body_size 0;
    }

    location ^~ /gd-jupyter/ {
        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
        proxy_buffering off;

        proxy_pass http://192.168.49.2:80;
    }

    location ^~ /gd-cim-api/ {
        proxy_pass http://localhost:8000;
        rewrite ^/gd-cim-api(/.*)$ $1 break;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /gd-kpi-api/ {
